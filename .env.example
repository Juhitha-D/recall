# Copy this file to .env. Everything is optional:
# without an AI key, Recall makes cards with its offline generator.
# .env is in .gitignore, so your keys never get pushed to GitHub.

# Pick ONE AI provider for smarter cards
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# For Groq or a local Ollama, set OPENAI_BASE_URL, e.g. http://localhost:11434/v1
# OPENAI_BASE_URL=

# How many brand-new cards to introduce per day (reviews are unlimited)
NEW_CARDS_PER_DAY=20
